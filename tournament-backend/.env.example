# ============================================================
# PRODUCTION CHECKLIST — Change all values marked [CHANGE ME]
# ============================================================
# APP_DEBUG=false         [set below for production template]
# APP_KEY=                [RUN: php artisan key:generate]
# DB_PASSWORD=            [CHANGE ME — never use empty password in production]
# MAIL_*                  [CHANGE ME — configure real mail driver]
# FRONTEND_URL=           [CHANGE ME — set to your real domain]
# ============================================================

APP_NAME="Tournament Platform"
APP_ENV=production
APP_KEY=
# IMPORTANT: Never set APP_DEBUG=true in production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# Local dev: copy to .env and use APP_ENV=local, APP_DEBUG=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use error in production (see .env.production.example)
LOG_LEVEL=debug

# --- Database (MySQL recommended for production) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tournament_db
DB_USERNAME=root
DB_PASSWORD=

# SQLite alternative: DB_CONNECTION=sqlite (no DB_HOST needed)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# --- Frontend & CORS ---
# Set to your frontend's full URL. If unset, CORS allows no origins (safe default).
# Dev: http://127.0.0.1:5500,http://localhost:5500
# Prod: https://yourdomain.com only
FRONTEND_URL=http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# HttpOnly auth cookie (enable in production with HTTPS + SESSION_DOMAIN)
ARENA_HTTPONLY_AUTH_COOKIE=false

# Seed passwords (required in production — never leave empty on public servers)
ADMIN_SEED_PASSWORD=
PLAYER_SEED_PASSWORD=

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (password reset, orders, bulk email) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@arena.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:5500,localhost:5500

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

VITE_APP_NAME="${APP_NAME}"

# --- Stripe (optional — enables shop + entry fee collection) ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_CURRENCY=usd

# --- Email verification gate on login ---
ARENA_REQUIRE_EMAIL_VERIFICATION=false

# --- Realtime notifications (optional) ---
# BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
