# Arena API — production environment template (NO real secrets)
# Copy to .env on the server and fill every [CHANGE ME] value.
# Never commit the real .env file.

APP_NAME="Arena Tournament Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# Database: PostgreSQL (Recommended for production, e.g. Neon.tech or Render Postgres)
DB_CONNECTION=pgsql
# Option A: Full connection URL (Neon.tech / Render provides this directly)
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Option B: Individual host/port parameters
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=arena_app
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.yourdomain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Required — CORS denies all origins if these are empty
FRONTEND_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

SANCTUM_STATEFUL_DOMAINS=yourdomain.com,www.yourdomain.com
ARENA_HTTPONLY_AUTH_COOKIE=true

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Only for first deploy seed — remove or leave empty after seeding
ADMIN_SEED_PASSWORD=
PLAYER_SEED_PASSWORD=
